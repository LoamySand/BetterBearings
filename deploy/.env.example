# Copy to .env next to compose.yml, then: chmod 600 .env
# Generate secrets with: openssl rand -hex 32  (hex keeps them URL-safe for DATABASE_URL)
COMPOSE_PROJECT_NAME=betterbearings   # staging: betterbearings-staging (without it, the project is named after the directory)
IMAGE_TAG=latest              # deploy.sh overwrites this with sha-<7> on every deploy
APP_PORT=5000                 # staging: 5001
POSTGRES_PASSWORD=
JWT_SECRET=
CORS_ORIGINS=https://betterbearings.net,https://www.betterbearings.net
TRUST_PROXY=0                 # 1 once the Cloudflare Tunnel is in front

# Password reset email through Resend (KAN-69). Required: the app won't start without them.
# A sending-only API key for betterbearings.net. Each environment can use its own key.
RESEND_API_KEY=
APP_URL=https://betterbearings.net   # staging: https://staging.betterbearings.net (no trailing slash)
# EMAIL_FROM=BetterBearings <noreply@betterbearings.net>
# EMAIL_REPLY_TO=contact@betterbearings.net
# LOG_LEVEL=info
# Loamy-prod only. Dev tests leave both unset.
# COMPOSE_PROFILES=tunnel
# TUNNEL_TOKEN=

# Map tiles (KAN-53). Unset means tile.openstreetmap.org. Must contain {z}, {x}, {y}; https or a /path.
# A URL ending in .mvt or .pbf is drawn as vector tiles without street labels (KAN-55).
# Self-hosted (KAN-54):
#   prod:    TILE_URL=https://tiles.betterbearings.net/nm/{z}/{x}/{y}.mvt
#   staging: TILE_URL=https://tiles-staging.betterbearings.net/nm/{z}/{x}/{y}.mvt
#   TILE_ATTRIBUTION='<a href="https://protomaps.com">Protomaps</a> &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'   (single quotes keep it literal)
# TILE_URL=
# TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# Directory of .pmtiles files served by the tiles service (KAN-54).
# TILES_DIR=/srv/betterbearings/tiles
