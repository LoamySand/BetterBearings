# Copy to .env next to compose.yml, then: chmod 600 .env
# Generate secrets with: openssl rand -hex 32  (hex keeps them URL-safe for DATABASE_URL)
COMPOSE_PROJECT_NAME=betterbearings   # staging: betterbearings-staging (without it, the project is named after the directory)
IMAGE_TAG=latest              # deploy.sh overwrites this with sha-<7> on every deploy
APP_PORT=5000                 # staging: 5001
POSTGRES_PASSWORD=
JWT_SECRET=
CORS_ORIGINS=https://betterbearings.net,https://www.betterbearings.net
TRUST_PROXY=0                 # 1 once the Cloudflare Tunnel is in front
# LOG_LEVEL=info
# Loamy-prod only. Dev tests leave both unset.
# COMPOSE_PROFILES=tunnel
# TUNNEL_TOKEN=

# Map tiles (KAN-53). Unset means tile.openstreetmap.org. Must contain {z}, {x}, {y}; https or a /path.
# TILE_URL=
# TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
